# 이 파일을 복사해 .env 로 만든 뒤 값을 채우세요. (.env 는 커밋 금지)
# ⚠️ VITE_ 로 시작하는 값은 브라우저에 그대로 노출됩니다.
#    API 키 같은 비밀값은 절대 여기에 넣지 말고 백엔드(SpotON-BE)에서 처리하세요.

# 서버 주소만 지정합니다. /api 접두사는 API 클라이언트가 붙입니다.
VITE_API_BASE_URL=http://localhost:8000

# true 로 두면 백엔드 없이 src/api/mocks 의 예시 응답으로 화면을 개발할 수 있어요
VITE_USE_MOCK=false

# VITE_USE_MOCK=true 일 때만 사용: 여기 적은 API 경로만 실제 서버로 호출하고 나머지는 목업 (쉼표 구분, 예: /geocode,/stores/history)
VITE_REAL_API_PATHS=
