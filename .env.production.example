# 배포용 환경변수 예시 — 복사해 .env.production 으로 만든 뒤 값을 채우세요. (.env.production 은 커밋 금지)
# `npm run build` 는 .env.production 을 읽습니다. 자세한 내용은 docs/deploy.md
# ⚠️ VITE_ 로 시작하는 값은 브라우저에 그대로 노출됩니다. 비밀값은 넣지 마세요 (카카오맵 JavaScript 키만 예외).

# 배포한 백엔드 서버 주소만 적습니다 (끝에 / 없이). /api 접두사는 API 클라이언트가 붙입니다.
VITE_API_BASE_URL=https://배포-BE-주소

# 배포 빌드는 반드시 false — 목업 코드와 시연용 데이터가 결과물에서 빠집니다
VITE_USE_MOCK=false

# 목업 모드 전용이라 배포에서는 비워 둡니다
VITE_REAL_API_PATHS=

# 카카오맵 JavaScript 키 (브라우저 공개용). 카카오 개발자 콘솔에 배포 도메인을 꼭 등록하세요
VITE_KAKAO_JS_KEY=카카오맵-JavaScript-키
